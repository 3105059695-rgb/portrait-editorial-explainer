[
  {
    "start": 0.467,
    "end": 1.887,
    "text": "OpenAI这次数学突破，"
  },
  {
    "start": 1.887,
    "end": 3.307,
    "text": "已经不只是竞赛刷题了。"
  },
  {
    "start": 3.307,
    "end": 4.267,
    "text": "十月六日，"
  },
  {
    "start": 4.267,
    "end": 6.287,
    "text": "它开始公开内部模型生成的研究成果。"
  },
  {
    "start": 7.966,
    "end": 9.166,
    "text": "七百一十九篇稿件，"
  },
  {
    "start": 9.166,
    "end": 10.737,
    "text": "归成三百七十二组。"
  },
  {
    "start": 10.737,
    "end": 11.546,
    "text": "数论、几何，"
  },
  {
    "start": 11.746,
    "end": 12.626,
    "text": "理论计算机科学，"
  },
  {
    "start": 12.626,
    "end": 13.166,
    "text": "都在里面。"
  },
  {
    "start": 15.466,
    "end": 16.206,
    "text": "但稿件数量，"
  },
  {
    "start": 16.206,
    "end": 17.546,
    "text": "不等于攻克难题的数量。"
  },
  {
    "start": 17.546,
    "end": 19.193,
    "text": "相关结果、配套论证，"
  },
  {
    "start": 19.193,
    "end": 20.066,
    "text": "还有不同证明，"
  },
  {
    "start": 20.066,
    "end": 21.097,
    "text": "会归在同一组。"
  },
  {
    "start": 22.966,
    "end": 23.776,
    "text": "真正值得看的，"
  },
  {
    "start": 23.776,
    "end": 24.886,
    "text": "是证明怎么被检查。"
  },
  {
    "start": 24.886,
    "end": 26.106,
    "text": "模型写出推导，"
  },
  {
    "start": 26.106,
    "end": 27.106,
    "text": "再把其中一部分，"
  },
  {
    "start": 27.106,
    "end": 29.206,
    "text": "转成可以由计算机检查的形式化证明。"
  },
  {
    "start": 30.467,
    "end": 31.687,
    "text": "按十月七日的更新，"
  },
  {
    "start": 31.687,
    "end": 33.327,
    "text": "七百一十九项主要结果中，"
  },
  {
    "start": 33.327,
    "end": 34.867,
    "text": "已有三百项完成形式化，"
  },
  {
    "start": 34.867,
    "end": 36.093,
    "text": "大约百分之四十二。"
  },
  {
    "start": 37.967,
    "end": 38.957,
    "text": "但它也会出错。"
  },
  {
    "start": 38.957,
    "end": 39.847,
    "text": "发布第二天，"
  },
  {
    "start": 39.847,
    "end": 42.407,
    "text": "三篇稿件因为符号错误及其影响被撤回。"
  },
  {
    "start": 42.727,
    "end": 43.667,
    "text": "另外十四篇，"
  },
  {
    "start": 43.667,
    "end": 44.452,
    "text": "也做了修订。"
  },
  {
    "start": 45.466,
    "end": 45.766,
    "text": "所以，"
  },
  {
    "start": 45.766,
    "end": 47.226,
    "text": "突破不只是写出答案，"
  },
  {
    "start": 47.226,
    "end": 48.186,
    "text": "而是走进研究："
  },
  {
    "start": 48.186,
    "end": 48.906,
    "text": "提出结果，"
  },
  {
    "start": 48.906,
    "end": 49.706,
    "text": "交出证明，"
  },
  {
    "start": 49.906,
    "end": 50.566,
    "text": "接受检查，"
  },
  {
    "start": 50.726,
    "end": 51.306,
    "text": "再继续修正。"
  },
  {
    "start": 52.966,
    "end": 55.146,
    "text": "这批成果来自尚未公开的内部模型。"
  },
  {
    "start": 55.146,
    "end": 56.256,
    "text": "接下来要看的，"
  },
  {
    "start": 56.256,
    "end": 57.846,
    "text": "是这些证明能不能被理解，"
  },
  {
    "start": 57.846,
    "end": 59.1,
    "text": "并真正推进数学。"
  }
]